# CareerGraph AI — environment configuration template
# Copy to .env and fill in real values. Never commit .env.
# All keys are optional unless noted; defaults live in src/core/config.py.

# ── Pipeline thresholds ───────────────────────────────────────────────────
MIN_FIT_SCORE=72.0
RESUME_TARGET_PAGES=1

# ── Storage paths & checkpointers ─────────────────────────────────────────
DB_PATH=./data/careergraph.db
BROWSER_PROFILE_DIR=./data/browser_profile
ARTIFACTS_DIR=./data/artifacts
H1B_DATA_PATH=./data/h1b_sponsors.json
COMPANIES_CONFIG_PATH=./data/sample/companies.yaml
CHECKPOINTER_DRIVER=sqlite        # sqlite | memory | postgres
# POSTGRES_CHECKPOINTER_URL=
NODE_TIMEOUT_SECONDS=45.0

# ── Candidate profile & PDF compiler ──────────────────────────────────────
# Candidate profile directory (default ships fictional sample persona).
# Point this at a PRIVATE directory outside the repo for real personal usage:
# PROFILE_DATA_DIR=/path/to/my-profile
PROFILE_DATA_DIR=./data/sample
ACTIVE_CANDIDATE_ID=default
PDF_COMPILER_BACKEND=reportlab    # reportlab | typst

# ── API keys & LLM providers ──────────────────────────────────────────────
PRIMARY_LLM_PROVIDER=mock         # mock | alibaba | gemini | openrouter
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
ALIBABA_MODEL=qwen3.6-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Telegram bot (mobile HITL approvals) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Server ─────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Security hardening ─────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
CORS_ORIGINS=*                    # comma-separated allowed origins; "*" for dev

# ── Browser Use (Tier 2 submission) ────────────────────────────────────────
BROWSER_USE_ENABLED=true          # kill switch for LLM-driven submission agent
BROWSER_USE_VISION=auto           # auto | true | false
BROWSER_USE_MAX_STEPS=30
BROWSER_USE_MAX_FAILURES=3
BROWSER_USE_TIMEOUT_SECONDS=90
BROWSER_USE_MODEL=qwen-vl-max
BROWSER_USE_FALLBACK_PROVIDER=gemini
BROWSER_USE_FALLBACK_MODEL=gemini-2.5-flash

# ── Submission audit ───────────────────────────────────────────────────────
SUBMISSION_AUDIT_ENABLED=true

# ── CapSolver (captcha) ────────────────────────────────────────────────────
CAPSOLVER_API_KEY=
CAPSOLVER_TIMEOUT_SEC=120
CAPTCHA_AUTO_SOLVE=false

# ── Credential vault ───────────────────────────────────────────────────────
CREDENTIAL_BACKEND=keyring        # keyring | env | file
CREDENTIAL_SERVICE_NAME=careergraph
CREDENTIAL_FILE_PATH=./data/credentials.json

# ── P5b Adzuna (https://developer.adzuna.com — free developer keys) ────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── P5c auto-submit policy ─────────────────────────────────────────────────
# When false, ApplicationAgent never resumes past the submit interrupt;
# submissions happen only via `mission resume <JOB_ID>`.
AUTO_SUBMIT_ENABLED=false
